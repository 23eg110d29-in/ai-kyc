# ─────────────────────────────────────────────────────────────
# AI KYC Document Verification Assistant – Environment Variables
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# MongoDB
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/kyc_db
DATABASE_NAME=kyc_db

# JWT / Auth
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq LLM
GROQ_API_KEY=your-groq-api-key-here

# LangSmith Tracing
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=ai-kyc-verification

# Google Vision (optional, for enhanced OCR)
GOOGLE_VISION_API_KEY=optional-google-vision-key

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ChromaDB
CHROMA_PERSIST_DIR=chroma_data

# App Environment
ENVIRONMENT=development
